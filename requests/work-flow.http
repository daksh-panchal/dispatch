@baseUrl = http://localhost:5080
@jobId = 01a1040c-b739-7531-a794-276fe1d593ec
@workerId = 01a11050-2eeb-77f6-b773-f471c252c0fc
@claimedJobId = 01a11052-d37a-7191-be2b-b6d6754683a9
@leaseToken = 01a11052-f3a9-7d3e-b118-2420b754cb62

### Liveness
GET {{baseUrl}}/health/live

### Readiness (includes PostgreSQL)
GET {{baseUrl}}/health/ready

### Submit a job
POST {{baseUrl}}/api/v1/jobs
Content-Type: application/json
Idempotency-Key: example-build-005

{
  "queue": "default",
  "priority": 0,
  "maximumAttempts": 3,
  "payload": {
    "command": "example"
  }
}

### Retrieve a job
GET {{baseUrl}}/api/v1/jobs/{{jobId}}

### Register a worker
POST {{baseUrl}}/api/v1/workers
Content-Type: application/json

{
  "name": "local-builder-2",
  "queue": "default"
}

### Record a worker heartbeat
POST {{baseUrl}}/api/v1/workers/{{workerId}}/heartbeat

### Claim the highest-priority eligible job
POST {{baseUrl}}/api/v1/workers/{{workerId}}/claims

### Renew ownership of a claimed job
POST {{baseUrl}}/api/v1/workers/{{workerId}}/jobs/{{claimedJobId}}/lease
Content-Type: application/json

{
  "leaseToken": "{{leaseToken}}"
}

### Complete a claimed job
POST {{baseUrl}}/api/v1/workers/{{workerId}}/jobs/{{claimedJobId}}/complete
Content-Type: application/json

{
  "leaseToken": "{{leaseToken}}",
  "result": {
    "artifact": "example.zip"
  }
}

### Report a failed attempt (retries automatically when attempts remain)
POST {{baseUrl}}/api/v1/workers/{{workerId}}/jobs/{{claimedJobId}}/fail
Content-Type: application/json

{
  "leaseToken": "{{leaseToken}}",
  "error": "build command exited with status 1"
}
