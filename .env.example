# Optional Docker Compose overrides. The defaults work without this file.
POSTGRES_PORT=5432
WORKFLOW_API_PORT=5080
WORKFLOW_DEMO_PORT=5090

# Short timings make lease recovery visible during the local demo.
LEASE_DURATION=8s
RETRY_BASE=1s
RETRY_MAXIMUM=30s
RECOVERY_INTERVAL=500ms
RECOVERY_BATCH_SIZE=100
SHUTDOWN_TIMEOUT=10s
DEMO_SHUTDOWN_TIMEOUT=10s
