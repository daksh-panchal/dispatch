{
  "openapi": "3.1.0",
  "info": {
    "title": "Dispatch API",
    "version": "6.1.0"
  },
  "paths": {
    "/health/live": {
      "get": { "responses": { "200": { "description": "Process is alive" } } }
    },
    "/health/ready": {
      "get": { "responses": { "200": { "description": "PostgreSQL is reachable" }, "503": { "description": "Not ready" } } }
    },
    "/api/v1/jobs": {
      "get": {
        "parameters": [
          { "name": "queue", "in": "query", "schema": { "type": "string", "maxLength": 100 } },
          { "name": "state", "in": "query", "schema": { "type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled"] } },
          { "name": "cursor", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } }
        ],
        "responses": {
          "200": { "description": "Newest jobs matching the filters" },
          "400": { "description": "Invalid filter or cursor" }
        }
      },
      "post": {
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmitJob" } } }
        },
        "responses": {
          "201": { "description": "Job created" },
          "200": { "description": "Existing idempotent job returned" },
          "409": { "description": "Idempotency key conflicts with another submission" }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Job found" },
          "404": { "description": "Job not found" }
        }
      }
    },
    "/api/v1/jobs/{id}/cancel": {
      "post": {
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Job cancelled, or previously cancelled job returned" },
          "404": { "description": "Job not found" },
          "409": { "description": "Job already succeeded or failed" }
        }
      }
    },
    "/api/v1/workers": {
      "get": {
        "parameters": [
          { "name": "queue", "in": "query", "schema": { "type": "string", "maxLength": 100 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } }
        ],
        "responses": {
          "200": { "description": "Registered workers with derived idle, busy, or offline status" },
          "400": { "description": "Invalid filter or cursor" }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterWorker" } } }
        },
        "responses": {
          "201": { "description": "Worker registered" },
          "400": { "description": "Invalid worker registration" }
        }
      }
    },
    "/api/v1/workers/{workerId}/heartbeat": {
      "post": {
        "parameters": [
          { "name": "workerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Worker heartbeat recorded" },
          "404": { "description": "Worker not found" }
        }
      }
    },
    "/api/v1/workers/{workerId}/claims": {
      "post": {
        "parameters": [
          { "name": "workerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Job claimed with a lease" },
          "204": { "description": "No eligible job is available" },
          "404": { "description": "Worker not found" }
        }
      }
    },
    "/api/v1/workers/{workerId}/jobs/{jobId}/lease": {
      "post": {
        "parameters": [
          { "name": "workerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "jobId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RenewLease" } } }
        },
        "responses": {
          "200": { "description": "Lease renewed" },
          "404": { "description": "Worker not found" },
          "409": { "description": "Lease is expired or no longer owned by this worker" }
        }
      }
    },
    "/api/v1/workers/{workerId}/jobs/{jobId}/complete": {
      "post": {
        "parameters": [
          { "name": "workerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "jobId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompleteJob" } } }
        },
        "responses": {
          "200": { "description": "Job completed successfully" },
          "404": { "description": "Worker or job not found" },
          "409": { "description": "Lease is expired or no longer owned by this worker" }
        }
      }
    },
    "/api/v1/workers/{workerId}/jobs/{jobId}/fail": {
      "post": {
        "parameters": [
          { "name": "workerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "jobId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FailJob" } } }
        },
        "responses": {
          "200": { "description": "Failure recorded; job was scheduled for retry or permanently failed" },
          "404": { "description": "Worker or job not found" },
          "409": { "description": "Lease is expired or no longer owned by this worker" }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "parameters": [
          { "name": "queue", "in": "query", "schema": { "type": "string", "maxLength": 100 } },
          { "name": "jobId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "afterSequence", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } }
        ],
        "responses": {
          "200": { "description": "Durable job lifecycle events in sequence order" },
          "400": { "description": "Invalid filter or sequence cursor" }
        }
      }
    },
    "/api/v1/events/stream": {
      "get": {
        "description": "Streams durable job lifecycle events using Server-Sent Events. Last-Event-ID can resume a disconnected stream.",
        "parameters": [
          { "name": "queue", "in": "query", "schema": { "type": "string", "maxLength": 100 } },
          { "name": "jobId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "afterSequence", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "Last-Event-ID", "in": "header", "schema": { "type": "integer", "minimum": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Live event stream",
            "content": { "text/event-stream": {} }
          },
          "400": { "description": "Invalid filter or sequence cursor" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SubmitJob": {
        "type": "object",
        "required": ["queue", "payload", "maximumAttempts"],
        "properties": {
          "queue": { "type": "string" },
          "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 },
          "payload": {},
          "maximumAttempts": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "RegisterWorker": {
        "type": "object",
        "required": ["name", "queue"],
        "properties": {
          "name": { "type": "string", "maxLength": 100 },
          "queue": { "type": "string", "maxLength": 100 }
        }
      },
      "RenewLease": {
        "type": "object",
        "required": ["leaseToken"],
        "properties": {
          "leaseToken": { "type": "string", "format": "uuid" }
        }
      },
      "CompleteJob": {
        "type": "object",
        "required": ["leaseToken", "result"],
        "properties": {
          "leaseToken": { "type": "string", "format": "uuid" },
          "result": {}
        }
      },
      "FailJob": {
        "type": "object",
        "required": ["leaseToken", "error"],
        "properties": {
          "leaseToken": { "type": "string", "format": "uuid" },
          "error": { "type": "string", "maxLength": 4000 }
        }
      }
    }
  }
}
