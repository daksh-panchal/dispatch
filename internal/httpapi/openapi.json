{
  "openapi": "3.1.0",
  "info": {
    "title": "work-flow API",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": { "responses": { "200": { "description": "Process is alive" } } }
    },
    "/health/ready": {
      "get": { "responses": { "200": { "description": "PostgreSQL is reachable" }, "503": { "description": "Not ready" } } }
    },
    "/api/v1/jobs": {
      "post": {
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubmitJob" }
            }
          }
        },
        "responses": {
          "201": { "description": "Job created" },
          "200": { "description": "Existing idempotent job returned" },
          "409": { "description": "Idempotency key conflicts with another submission" }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Job found" },
          "404": { "description": "Job not found" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SubmitJob": {
        "type": "object",
        "required": ["queue", "payload", "maximumAttempts"],
        "properties": {
          "queue": { "type": "string" },
          "priority": { "type": "integer" },
          "payload": {},
          "maximumAttempts": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    }
  }
}

